generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Vendor {
  id                String   @id @default(cuid())
  code              String   @unique
  businessName      String
  contactName       String
  email             String   @unique
  phone             String   @default("")
  passwordHash      String
  commissionPercent Float    @default(0)
  mustChangePassword Boolean @default(false)
  acceptsPreorders  Boolean  @default(false)
  acceptsRequests   Boolean  @default(false)
  allowSelfCheckout Boolean  @default(true)
  publicBlurb       String   @default("")
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())
  items             Item[]
  ledger            LedgerEntry[]
  contracts         Contract[]
}

model Item {
  id         String   @id @default(cuid())
  vendorId   String
  vendor     Vendor   @relation(fields: [vendorId], references: [id])
  sku        String   @unique
  name       String
  priceCents Int
  quantity   Int      @default(0)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Sale {
  id            String     @id @default(cuid())
  number        Int        @default(0)
  status        String     @default("COMPLETE")
  cardName      String     @default("")
  employee      String     @default("")
  subtotalCents Int
  taxCents      Int
  totalCents    Int
  paymentMethod String
  createdAt     DateTime   @default(now())
  lines         SaleLine[]
}

model Employee {
  id          String   @id @default(cuid())
  name        String   @unique
  pinHash     String
  payRateCents Int     @default(0)
  w4Json      String   @default("{}")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model TimeEntry {
  id         String    @id @default(cuid())
  employeeId String
  clockIn    DateTime  @default(now())
  clockOut   DateTime?
  note       String    @default("")
}

model Deduction {
  id         String  @id @default(cuid())
  employeeId String
  name       String
  amountCents Int
  active     Boolean @default(true)
}

model EmployeeDoc {
  id         String   @id @default(cuid())
  employeeId String
  kind       String
  filename   String
  mime       String
  dataB64    String
  createdAt  DateTime @default(now())
}

model DrawerSession {
  id             String    @id @default(cuid())
  employee       String
  openedAt       DateTime  @default(now())
  closedAt       DateTime?
  openTotalCents Int
  openCounts     String    @default("{}")
  closeCounts    String    @default("{}")
  cashSalesCents Int       @default(0)
  countedCents   Int       @default(0)
  diffCents      Int       @default(0)
  status         String    @default("OPEN")
}

model SaleLine {
  id              String @id @default(cuid())
  saleId          String
  sale            Sale   @relation(fields: [saleId], references: [id], onDelete: Cascade)
  itemId          String
  vendorId        String
  name            String
  priceCents      Int
  quantity        Int
  commissionCents Int    @default(0)
  vendorNetCents  Int
}

model LedgerEntry {
  id          String   @id @default(cuid())
  vendorId    String
  vendor      Vendor   @relation(fields: [vendorId], references: [id])
  type        String
  amountCents Int
  note        String   @default("")
  createdAt   DateTime @default(now())
}

model Contract {
  id               String    @id @default(cuid())
  vendorId         String
  vendor           Vendor    @relation(fields: [vendorId], references: [id])
  boothLabel       String
  monthlyRentCents Int
  startDate        DateTime
  status           String    @default("ACTIVE")
  noticeGivenAt    DateTime?
  endDate          DateTime?
  vendorSignedName    String    @default("")
  vendorSignatureData String    @default("")
  vendorSignedAt      DateTime?
  marketSignedName    String    @default("")
  marketSignatureData String    @default("")
  marketSignedAt      DateTime?
  createdAt        DateTime  @default(now())
}

model Setting {
  key   String @id
  value String
}

model Refund {
  id          String   @id @default(cuid())
  saleId      String
  employee    String   @default("")
  method      String
  amountCents Int
  taxCents    Int
  restocked   Boolean  @default(true)
  linesJson   String   @default("[]")
  note        String   @default("")
  createdAt   DateTime @default(now())
}

model PushSub {
  id        String   @id @default(cuid())
  vendorId  String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}

model Review {
  id        String   @id @default(cuid())
  vendorId  String
  name      String
  rating    Int
  body      String
  likes     Int      @default(0)
  createdAt DateTime @default(now())
}

model ReviewComment {
  id        String   @id @default(cuid())
  reviewId  String
  name      String
  body      String
  likes     Int      @default(0)
  createdAt DateTime @default(now())
}

model Thread {
  id           String      @id @default(cuid())
  vendorId     String
  type         String
  customerName String
  email        String
  phone        String
  status       String      @default("OPEN")
  token        String      @unique
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @default(now())
  messages     ThreadMsg[]
}

model ThreadMsg {
  id        String   @id @default(cuid())
  threadId  String
  thread    Thread   @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender    String
  body      String
  createdAt DateTime @default(now())
}

model PreOrder {
  id              String    @id @default(cuid())
  threadId        String    @unique
  vendorId        String
  description     String
  subtotalCents   Int
  taxCents        Int
  totalCents      Int
  expectedDate    String
  token           String    @unique
  status          String    @default("ACCEPTED")
  stripeSessionId String    @default("")
  saleId          String    @default("")
  createdAt       DateTime  @default(now())
  paidAt          DateTime?
}

model VendorApplication {
  id           String    @id @default(cuid())
  businessName String
  contactName  String
  email        String
  phone        String
  category     String    @default("")
  products     String
  madeByYou    String    @default("")
  links        String    @default("")
  licenses     String    @default("")
  insurance    String    @default("")
  availability String    @default("")
  boothRequest String    @default("")
  heardFrom    String    @default("")
  notes        String    @default("")
  status       String    @default("PENDING")
  createdAt    DateTime  @default(now())
  decidedAt    DateTime?
}

model TentDate {
  id       String        @id @default(cuid())
  date     String        @unique
  capacity Int           @default(4)
  open     Boolean       @default(true)
  bookings TentBooking[]
}

model TentBooking {
  id              String   @id @default(cuid())
  dateId          String
  date            TentDate @relation(fields: [dateId], references: [id], onDelete: Cascade)
  name            String
  businessName    String   @default("")
  email           String
  phone           String
  status          String   @default("RESERVED")
  token           String   @unique
  stripeSessionId String   @default("")
  creditFromId    String   @default("")
  createdAt       DateTime @default(now())
}

model VendorPhoto {
  id        String   @id @default(cuid())
  vendorId  String
  kind      String   @default("PRODUCT")
  mime      String
  data      String
  createdAt DateTime @default(now())
}

model SelfCart {
  id              String    @id @default(cuid())
  token           String    @unique
  linesJson       String
  subtotalCents   Int
  taxCents        Int
  totalCents      Int
  email           String    @default("")
  status          String    @default("PENDING")
  stripeSessionId String    @default("")
  saleId          String    @default("")
  createdAt       DateTime  @default(now())
  paidAt          DateTime?
}
