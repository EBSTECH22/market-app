generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Vendor {
  id                String   @id @default(cuid())
  code              String   @unique
  businessName      String
  contactName       String
  email             String   @unique
  phone             String   @default("")
  passwordHash      String
  commissionPercent Float    @default(0)
  mustChangePassword Boolean @default(false)
  acceptsPreorders  Boolean  @default(false)
  acceptsRequests   Boolean  @default(false)
  allowSelfCheckout Boolean  @default(true)
  // Warn this vendor when an item drops to this many units. 0 is OFF, and off
  // is the default: a vendor selling one-of-a-kind work keeps every item at a
  // quantity of one on purpose, and a threshold applied to everyone stamped
  // "low stock" across their entire booth. Anyone who wants the warning turns
  // it on and picks their own number.
  lowStockThreshold Int      @default(0)
  lastRestockAlertAt DateTime?
  portalLocked     Boolean @default(false)
  stripeCustomerId String  @default("")
  stripePmId       String  @default("")
  cardLast4        String  @default("")
  // Their own Stripe Express account, for being PAID. Separate from the three
  // fields above, which are about charging them rent — a vendor can have a card
  // on file and no way to receive money, or the reverse.
  //
  // Nothing about their bank account is stored here. Stripe holds it; this is
  // only the id that lets us send money to it, which means a copy of this
  // database is not a pile of vendors' bank details.
  stripeAccountId  String  @default("")
  // Mirrors Stripe's own answer to "can this account receive money yet", kept
  // current by the account.updated webhook. Onboarding can stall days later
  // when Stripe asks for another document, so this is never assumed from the
  // fact that they finished the form once.
  payoutsEnabled   Boolean @default(false)
  // What Stripe is still waiting on, in plain words, so the vendor portal can
  // say something more useful than "pending".
  payoutStatusNote String  @default("")
  publicBlurb       String   @default("")
  // The storefront. publicBlurb stays as the one-line summary that shows in
  // listings; these are the page itself.
  //
  // A booth in a market sells on a story and a face — "we've milled our own
  // flour since 2019" does work that a product list can't. Separate fields
  // rather than one blob of HTML because they appear in different places: the
  // tagline under the name, the story below the fold, the links in the footer.
  tagline           String   @default("")
  story             String   @default("")
  instagramUrl      String   @default("")
  facebookUrl       String   @default("")
  websiteUrl        String   @default("")
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())
  items             Item[]
  ledger            LedgerEntry[]
  contracts         Contract[]
  orders            Order[]
}

model Item {
  id         String   @id @default(cuid())
  vendorId   String
  vendor     Vendor   @relation(fields: [vendorId], references: [id])
  sku        String   @unique
  name       String
  priceCents Int
  salePercent Int      @default(0)
  quantity   Int      @default(0)
  active     Boolean  @default(true)
  // STANDARD or FOOD. Oklahoma exempts food and food ingredients from the state
  // portion of sales tax but not the local portion, so groceries are taxed at a
  // lower rate rather than not at all. Defaults to STANDARD: an item nobody has
  // classified is taxed at the full rate, which is the safe direction to be
  // wrong in.
  taxClass   String   @default("STANDARD")
  // What kind of thing this is — "Candles", "Baked goods", "Jewelry". Free text
  // chosen from a suggested list rather than a fixed enum, because a market's
  // categories are whatever walked in the door this season. Used only to
  // compare against other vendors selling the same kind of thing.
  category   String   @default("")
  // What the shopper reads before deciding. An item with a name and a price is
  // a line in a stock list; an item with a description is something somebody
  // might buy without holding it first.
  description String  @default("")
  // "per dozen", "8 oz jar", "each" — the unit the price is for. Without it a
  // $14 jar of honey looks expensive next to a $6 one that's half the size.
  unitLabel  String   @default("")
  // Pinned to the front of the vendor's storefront. Their best three things,
  // chosen by them, rather than whatever sorts first alphabetically.
  featured   Boolean  @default(false)
  // ---- selling online -------------------------------------------------
  // Off by default and opted into per product. The market's floor stock is NOT
  // an online catalogue: a shopper standing at the booth holding the last jar
  // must not lose it to an order placed from a sofa thirty seconds earlier.
  onlineEnabled  Boolean @default(false)
  // Stock set aside for online orders, counted SEPARATELY from `quantity`.
  // Online orders only ever draw this number down; the register only ever draws
  // `quantity` down. Two counts is the whole reason the two channels can't
  // sell each other's goods.
  onlineQuantity Int     @default(0)
  // How the vendor will get it to the buyer. Pickup at the market is the
  // default because it costs nobody anything.
  onlinePickup   Boolean @default(true)
  onlineShip     Boolean @default(false)
  // What the vendor charges to post this one item. Shipping is the vendor's
  // responsibility and their money — the market doesn't take commission on it
  // and doesn't tax it (Oklahoma doesn't tax separately-stated delivery).
  shipCents      Int     @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([category])
}

// A price or sale-percent change, so "did that discount work" can be answered.
//
// There is no way to reconstruct this after the fact — an item's row only ever
// holds its CURRENT price, so the day a vendor put something on sale is simply
// gone unless it's written down when it happens. Which means this starts empty
// and only becomes useful after the next price change. Nothing to backfill.
model PriceEvent {
  id            String   @id @default(cuid())
  itemId        String
  vendorId      String
  oldPriceCents Int
  newPriceCents Int
  oldSalePercent Int     @default(0)
  newSalePercent Int     @default(0)
  createdAt     DateTime @default(now())

  @@index([itemId, createdAt])
  @@index([vendorId])
}

model Sale {
  id            String     @id @default(cuid())
  number        Int        @default(0)
  status        String     @default("COMPLETE")
  cardName      String     @default("")
  employee      String     @default("")
  subtotalCents Int
  taxCents      Int
  totalCents    Int
  paymentMethod String
  customerId    String     @default("")
  discountCents Int        @default(0)
  cardAdjustCents Int      @default(0)
  saleSavingsCents Int    @default(0)
  // Cash sales only. 0 means the tender wasn't recorded (exact-change path, or
  // a sale booked before the register asked), NOT that nothing was handed over.
  cashTenderedCents Int    @default(0)
  changeCents     Int      @default(0)
  // Set when a vendor rang this at their own booth rather than a cashier at the
  // register. Empty for every normal sale. `employee` still carries the human
  // label; this is the id you can actually group and report on.
  soldByVendorId String    @default("")
  // The drawer this was rung on, so each person's till counts only its own
  // cash. Empty for sales rung before drawers were per-person.
  drawerId       String    @default("")
  // The tax split as charged. Stored rather than recomputed because the rates
  // in Settings change, and a return filed in March must show what was actually
  // collected in February.
  foodTaxCents     Int      @default(0)
  standardTaxCents Int      @default(0)
  // Idempotency key, minted by the till BEFORE the sale is sent. The same key
  // can arrive twice — a retry, a sync running in two tabs, or a response lost
  // after the server already committed — and the second arrival returns the
  // first ticket instead of ringing a duplicate. That last case is why every
  // sale carries one and not just the offline ones: a request that times out
  // has not necessarily failed.
  //
  // Empty on sales rung before this existed, which is why uniqueness is a
  // PARTIAL index created in SQL (WHERE "idemKey" <> '') rather than @unique
  // here — @unique would let exactly one sale in the system have an empty key.
  idemKey       String     @default("")
  createdAt     DateTime   @default(now())
  lines         SaleLine[]

  @@index([soldByVendorId])
  @@index([idemKey])
}

model Employee {
  id          String   @id @default(cuid())
  name        String   @unique
  pinHash     String
  payRateCents Int     @default(0)
  w4Json      String   @default("{}")
  active      Boolean  @default(true)
  // OWNER | MANAGER | EMPLOYEE. Everyone who already exists becomes EMPLOYEE,
  // which is exactly the access they have today — nobody is promoted by a
  // migration. See lib/perm.ts for what each role can reach.
  role        String   @default("EMPLOYEE")
  // Managers and owners sign in with email + password; employees keep the PIN,
  // which is what the register needs. Empty for PIN-only staff. Uniqueness is
  // enforced by a partial index (WHERE email <> '') so any number of employees
  // can have no email at all.
  email        String  @default("")
  passwordHash String  @default("")
  mustChangePassword Boolean @default(false)
  createdAt   DateTime @default(now())
}

model TimeEntry {
  id         String    @id @default(cuid())
  employeeId String
  clockIn    DateTime  @default(now())
  clockOut   DateTime?
  note       String    @default("")
}

model Deduction {
  id         String  @id @default(cuid())
  employeeId String
  name       String
  amountCents Int
  active     Boolean @default(true)
}

model EmployeeDoc {
  id         String   @id @default(cuid())
  employeeId String
  kind       String
  filename   String
  mime       String
  dataB64    String
  createdAt  DateTime @default(now())
}

model DrawerSession {
  id             String    @id @default(cuid())
  employee       String
  // Whose drawer this is. One open drawer PER PERSON, not per market. Empty on
  // drawers opened before that change, which keep the old time-window count.
  employeeId     String    @default("")
  openedAt       DateTime  @default(now())
  closedAt       DateTime?
  openTotalCents Int
  openCounts     String    @default("{}")
  closeCounts    String    @default("{}")
  cashSalesCents Int       @default(0)
  countedCents   Int       @default(0)
  diffCents      Int       @default(0)
  status         String    @default("OPEN")

  @@index([status, employeeId])
}

model SaleLine {
  id              String @id @default(cuid())
  saleId          String
  sale            Sale   @relation(fields: [saleId], references: [id], onDelete: Cascade)
  itemId          String
  vendorId        String
  name            String
  basePriceCents Int @default(0)
  priceCents      Int
  quantity        Int
  commissionCents Int    @default(0)
  vendorNetCents  Int
  // Copied from the item at the moment of sale. Reclassifying an item later
  // must not silently rewrite the tax on tickets already rung and filed.
  taxClass        String @default("STANDARD")
}

model LedgerEntry {
  id          String   @id @default(cuid())
  vendorId    String
  vendor      Vendor   @relation(fields: [vendorId], references: [id])
  type        String
  amountCents Int
  note        String   @default("")
  createdAt   DateTime @default(now())
}

model Contract {
  id               String    @id @default(cuid())
  vendorId         String
  vendor           Vendor    @relation(fields: [vendorId], references: [id])
  boothLabel       String
  monthlyRentCents Int
  startDate        DateTime
  status           String    @default("ACTIVE")
  noticeGivenAt    DateTime?
  endDate          DateTime?
  vendorSignedName    String    @default("")
  vendorSignatureData String    @default("")
  vendorSignedAt      DateTime?
  marketSignedName    String    @default("")
  marketSignatureData String    @default("")
  marketSignedAt      DateTime?
  signToken           String    @default("")
  viewedAt  DateTime?
  paidThrough DateTime?
  /// Which kind of space this agreement is for (a SpaceOffer `key`). Empty on
  /// agreements written before the offers existed — the office can mark those.
  spaceKey    String    @default("")
  /// Set when the booth was opened back up because the invoice went unpaid.
  /// The agreement is NOT ended — they can still pay and be re-held — but the
  /// space is available to let in the meantime, and both sides know it.
  spaceReleasedAt DateTime?
  createdAt        DateTime  @default(now())
}

model Setting {
  key   String @id
  value String
}

model Refund {
  id          String   @id @default(cuid())
  saleId      String
  // The drawer the cash came out of. Empty when it wasn't cash, or predates
  // per-person drawers.
  drawerId    String   @default("")
  employee    String   @default("")
  method      String
  amountCents Int
  taxCents    Int
  restocked   Boolean  @default(true)
  linesJson   String   @default("[]")
  note        String   @default("")
  createdAt   DateTime @default(now())
}

model PushSub {
  id        String   @id @default(cuid())
  vendorId  String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}

model Review {
  id        String   @id @default(cuid())
  vendorId  String
  name      String
  rating    Int
  body      String
  likes     Int      @default(0)
  createdAt DateTime @default(now())
}

model ReviewComment {
  id        String   @id @default(cuid())
  reviewId  String
  name      String
  body      String
  likes     Int      @default(0)
  createdAt DateTime @default(now())
}

model Thread {
  id           String      @id @default(cuid())
  vendorId     String
  type         String
  customerName String
  email        String
  phone        String
  status       String      @default("OPEN")
  token        String      @unique
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @default(now())
  messages     ThreadMsg[]
}

model ThreadMsg {
  id        String   @id @default(cuid())
  threadId  String
  thread    Thread   @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender    String
  body      String
  createdAt DateTime @default(now())
}

model PreOrder {
  id              String    @id @default(cuid())
  threadId        String    @unique
  vendorId        String
  description     String
  subtotalCents   Int
  taxCents        Int
  totalCents      Int
  expectedDate    String
  token           String    @unique
  status          String    @default("ACCEPTED")
  stripeSessionId String    @default("")
  saleId          String    @default("")
  createdAt       DateTime  @default(now())
  paidAt          DateTime?
}

/// What the market has to let, and on what terms.
///
/// Rows, not hard-coded options, because what is on offer changes with the
/// building: booths sell out, a shelf programme starts, a size stops being
/// offered. The apply page reads these, so the public page and the office can
/// never disagree about price or availability — which is what happens the
/// moment a price lives in two places.
model SpaceOffer {
  id                String  @id @default(cuid())
  /// Stable name the application stores, so renaming the offer doesn't orphan
  /// applications: BOOTH_5X5 | SMALL_DISPLAY | MARKET_SPACE.
  key               String  @unique
  name              String
  blurb             String  @default("")
  /// Monthly price. With priceMaxCents set, the two read as a range.
  priceCents        Int     @default(0)
  priceMaxCents     Int     @default(0)
  /// Taken off their sales. Only Market Space charges one today.
  commissionPercent Float   @default(0)
  /// How many are left to let. -1 means no limit (shelf space, not booths).
  available         Int     @default(0)
  /// Applications go to the waiting list whatever the count says.
  waitlistOnly      Boolean @default(false)
  active            Boolean @default(true)
  sortOrder         Int     @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

/// A space promised to someone by hand.
///
/// "I'll hold a 5x5 for you until Friday" is a real promise a market makes on
/// the phone, and until now it lived in somebody's head. A hold takes one off
/// what the apply page offers, names who it's for and when it runs out, and
/// puts the space back on its own if that date passes.
model SpaceHold {
  id            String    @id @default(cuid())
  /// Which kind of space (a SpaceOffer `key`).
  spaceKey      String
  /// Who it's for, as the market would say it out loud.
  heldFor       String
  email         String    @default("")
  phone         String    @default("")
  /// The application they came from, when they came from one.
  applicationId String    @default("")
  note          String    @default("")
  /// When the promise runs out. Null means until somebody says otherwise.
  holdUntil     DateTime?
  /// Who made the promise, for the conversation later.
  createdBy     String    @default("")
  createdAt     DateTime  @default(now())
  /// Set when the hold ends — taken up, let go, or run out.
  releasedAt    DateTime?
  releasedWhy   String    @default("")

  @@index([spaceKey, releasedAt])
}

model VendorApplication {
  id           String    @id @default(cuid())
  businessName String
  contactName  String
  email        String
  phone        String
  category     String    @default("")
  products     String
  madeByYou    String    @default("")
  links        String    @default("")
  licenses     String    @default("")
  insurance    String    @default("")
  availability String    @default("")
  boothRequest String    @default("")
  heardFrom    String    @default("")
  phoneType    String    @default("")
  notes        String    @default("")
  status       String    @default("PENDING")
  createdAt    DateTime  @default(now())
  decidedAt    DateTime?
  adminNotes String @default("")
  stage      String @default("NEW")
  /// Which SpaceOffer they applied for (its `key`), empty for older rows.
  spaceKey   String @default("")
  /// Set once a space was actually committed to them, so the count is taken
  /// off exactly once no matter how many times they're accepted or re-saved.
  spaceClaimedAt DateTime?
  viewingAt  String @default("")
  vendorId   String @default("")
}

model TentDate {
  id       String        @id @default(cuid())
  date     String        @unique
  capacity Int           @default(4)
  open     Boolean       @default(true)
  bookings TentBooking[]
}

model TentBooking {
  id              String   @id @default(cuid())
  dateId          String
  date            TentDate @relation(fields: [dateId], references: [id], onDelete: Cascade)
  name            String
  businessName    String   @default("")
  email           String
  phone           String
  status          String   @default("RESERVED")
  token           String   @unique
  stripeSessionId String   @default("")
  creditFromId    String   @default("")
  createdAt       DateTime @default(now())
}

model VendorPhoto {
  id        String   @id @default(cuid())
  vendorId  String
  itemId    String   @default("")
  /// LOGO | COVER | PRODUCT (the vendor's gallery) | ITEM (one product's photos)
  kind      String   @default("PRODUCT")
  mime      String
  data      String
  /// Lowest first. The first photo on an item is the one that sells it, so
  /// which photo leads has to be the vendor's choice and not an accident of
  /// upload order.
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([vendorId, kind])
  @@index([itemId])
}

model SelfCart {
  id              String    @id @default(cuid())
  token           String    @unique
  linesJson       String
  subtotalCents   Int
  taxCents        Int
  totalCents      Int
  email           String    @default("")
  status          String    @default("PENDING")
  stripeSessionId String    @default("")
  saleId          String    @default("")
  // Set when a vendor built this cart at their own booth. Reused rather than
  // given its own table because the paid-cart finalizer, the Stripe webhook and
  // the receipt email already work on SelfCart — a parallel table would have
  // meant a second copy of all of it.
  soldByVendorId  String    @default("")
  // Short code the customer carries to the register to pay cash. Empty on card
  // carts, cleared once it's been rung.
  registerCode    String    @default("")
  // The tax split as quoted to the customer. Carried on the cart rather than
  // recomputed at payment, because the rates in Settings can move between
  // showing someone a total and them paying it.
  foodTaxCents     Int      @default(0)
  standardTaxCents Int      @default(0)
  createdAt       DateTime  @default(now())
  paidAt          DateTime?

  @@index([registerCode])
}

model Customer {
  id           String   @id @default(cuid())
  email        String   @default("")
  phone        String   @default("")
  points       Int      @default(0)
  token        String   @unique
  unsubscribed Boolean  @default(false)
  createdAt    DateTime @default(now())
  follows      VendorFollow[]
}

model VendorFollow {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  vendorId   String
  createdAt  DateTime @default(now())
  @@unique([customerId, vendorId])
}

model LoyaltyEvent {
  id         String   @id @default(cuid())
  customerId String
  saleId     String   @default("")
  delta      Int
  note       String   @default("")
  createdAt  DateTime @default(now())
}

model Post {
  id        String   @id @default(cuid())
  vendorId  String
  body      String
  photoId   String   @default("")
  createdAt DateTime @default(now())
}

model VendorChatMsg {
  id        String   @id @default(cuid())
  vendorId  String
  body      String
  createdAt DateTime @default(now())
}

/// In-app calendar. Replaces keeping viewings in a separate app.
/// `kind` is a loose label rather than an enum so new event types don't need a
/// migration. Links to an application or vendor are plain id strings (not
/// relations) so deleting one never cascades into wiping calendar history.
model CalendarEvent {
  id            String    @id @default(cuid())
  title         String
  kind          String    @default("VIEWING")
  startAt       DateTime
  endAt         DateTime?
  allDay        Boolean   @default(false)
  location      String    @default("")
  notes         String    @default("")
  applicationId String    @default("")
  vendorId      String    @default("")
  contactName   String    @default("")
  contactPhone  String    @default("")
  contactEmail  String    @default("")
  status        String    @default("SCHEDULED")
  remindedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([startAt])
  @@index([applicationId])
  @@index([vendorId])
}

/// Every time someone opens a vendor-facing document. Admin views are never
/// recorded — the office looking at an invoice isn't a signal about the vendor.
/// `kind` is a loose label so new document types need no migration.
model ViewEvent {
  id         String   @id @default(cuid())
  kind       String   @default("INVOICE")
  targetId   String
  vendorId   String   @default("")
  viewerHash String   @default("")
  userAgent  String   @default("")
  viewedAt   DateTime @default(now())

  @@index([kind, targetId])
  @@index([vendorId])
  @@index([viewedAt])
}

/// Rate-limit counters. Fixed-window: the key carries the window start, so a
/// new window is simply a new row and expired rows are pruned opportunistically.
model RateLimit {
  key       String   @id
  count     Int      @default(0)
  expiresAt DateTime

  @@index([expiresAt])
}

/// Who did what to the money.
///
/// Sales, refunds and ledger entries already record WHAT happened. None of them
/// record who decided it, what it looked like before, or whether anyone
/// approved it — so a voided ticket, a price cut at 4pm and a balance written
/// off are all currently anonymous. With staff on the register that is exactly
/// where money leaves a business unnoticed.
///
/// Append-only by convention: nothing in the app updates or deletes a row here.
model AuditEvent {
  id          String   @id @default(cuid())
  at          DateTime @default(now())
  /// STAFF (an employee session) | OWNER_KEY (the shared admin password) |
  /// VENDOR | SYSTEM (cron, webhooks).
  actorType   String   @default("STAFF")
  actorId     String   @default("")
  actorName   String   @default("")
  actorRole   String   @default("")
  /// A stable machine name — SALE_VOID, SALE_REFUND, ITEM_PRICE, VENDOR_LEDGER,
  /// CONTRACT_EDIT, SETTING_CHANGE, EMPLOYEE_CHANGE, PAYOUT_PAID. Labels for
  /// humans live in lib/auditkinds.ts so client code can read them.
  action      String
  targetType  String   @default("")
  targetId    String   @default("")
  targetLabel String   @default("")
  /// Signed, in cents, when money moved. Positive is money out of the market.
  amountCents Int      @default(0)
  /// One sentence a person can read without decoding the JSON.
  detail      String   @default("")
  beforeJson  String   @default("")
  afterJson   String   @default("")
  /// The manager or owner who authorised it, when an approval was required.
  approvedBy  String   @default("")
  ip          String   @default("")

  @@index([at])
  @@index([action, at])
  @@index([targetType, targetId])
}

/// A batch of vendor payouts for one period.
///
/// Paying vendors was a one-at-a-time ledger entry with a note, which meant no
/// record of the batch, no statement, and no way to answer "did I pay everyone
/// in March". A run groups the payments, freezes what each vendor was owed at
/// the moment it was built, and survives as the thing you check against the
/// bank statement.
model PayoutRun {
  id          String    @id @default(cuid())
  /// The sales period the statements cover. The amount paid is always the
  /// vendor's CURRENT ledger balance, not this period's sales — see the route.
  periodStart DateTime
  periodEnd   DateTime
  /// OPEN while payments are still being marked, CLOSED once it's done.
  status      String    @default("OPEN")
  createdBy   String    @default("")
  note        String    @default("")
  createdAt   DateTime  @default(now())
  closedAt    DateTime?
  payouts     Payout[]

  @@index([createdAt])
}

/// One vendor's line in a payout run.
model Payout {
  id                 String    @id @default(cuid())
  runId              String
  run                PayoutRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  vendorId           String
  /// Copied at build time. A vendor renamed in June must not rewrite the
  /// statement you handed them in March.
  vendorCode         String    @default("")
  vendorName         String    @default("")
  /// The period's sales, for the statement.
  grossCents         Int       @default(0)
  commissionCents    Int       @default(0)
  refundCents        Int       @default(0)
  /// What the ledger said was payable when the run was built.
  balanceCents       Int       @default(0)
  /// What is actually being handed over.
  netCents           Int       @default(0)
  /// CASH | CHECK | ACH | STRIPE | RENT_OFFSET
  method             String    @default("")
  reference          String    @default("")
  /// The Stripe transfer, when it was paid by bank rather than by hand.
  transferId         String    @default("")
  /// Payout processing charged to the vendor, deducted from what's sent.
  feeCents           Int       @default(0)
  /// Why a bank transfer didn't go through, in Stripe's words.
  failureReason      String    @default("")
  /// PENDING | PAID | SKIPPED
  status             String    @default("PENDING")
  paidAt             DateTime?
  paidBy             String    @default("")
  ledgerEntryId      String    @default("")
  createdAt          DateTime  @default(now())

  @@unique([runId, vendorId])
  @@index([vendorId])
}


/// An online order: one customer, ONE VENDOR, paid up front.
///
/// One vendor per order, deliberately. Fulfillment, shipping, the ledger credit
/// and the payout all belong to a single vendor, so a cart spanning two booths
/// would have to be split into two of everything the moment it was paid for.
/// A shopper on a vendor's page is shopping with that vendor; buying from two
/// means two checkouts, which is honest about what's actually happening.
model Order {
  id             String   @id @default(cuid())
  number         Int      @unique
  vendorId       String
  vendor         Vendor   @relation(fields: [vendorId], references: [id])

  customerName   String   @default("")
  customerEmail  String
  customerPhone  String   @default("")
  /// Anything the customer typed at checkout — "leave with the neighbour".
  note           String   @default("")

  /// PICKUP | SHIP
  fulfillment    String   @default("PICKUP")
  /// Captured by Stripe at checkout for shipped orders; empty for pickup.
  shipName       String   @default("")
  shipLine1      String   @default("")
  shipLine2      String   @default("")
  shipCity       String   @default("")
  shipState      String   @default("")
  shipPostal     String   @default("")

  subtotalCents  Int      @default(0)
  /// Separately stated, untaxed, and passed to the vendor in full.
  shippingCents  Int      @default(0)
  taxCents       Int      @default(0)
  foodTaxCents   Int      @default(0)
  standardTaxCents Int    @default(0)
  totalCents     Int      @default(0)
  commissionCents Int     @default(0)
  /// What lands on the vendor's ledger: goods less commission, plus shipping.
  vendorNetCents Int      @default(0)

  /// PENDING → PAID → PACKED → READY → COLLECTED (pickup)
  ///                        → SHIPPED (post)
  /// plus EXPIRED (never paid) and CANCELLED / REFUNDED.
  status         String   @default("PENDING")
  /// The customer's own link to their order. Long and random — it is the only
  /// thing standing between a stranger and somebody's delivery address.
  token          String   @unique
  stripeSessionId String  @default("")
  carrier        String   @default("")
  trackingNumber String   @default("")

  createdAt      DateTime @default(now())
  paidAt         DateTime?
  readyAt        DateTime?
  completedAt    DateTime?

  lines          OrderLine[]

  @@index([vendorId, status])
  @@index([createdAt])
  @@index([status])
}

model OrderLine {
  id         String @id @default(cuid())
  orderId    String
  order      Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  itemId     String
  /// Copied at order time. A vendor renaming or repricing an item next week
  /// must not rewrite what somebody already bought.
  name       String
  unitLabel  String @default("")
  priceCents Int
  quantity   Int
  taxClass   String @default("STANDARD")
  shipCents  Int    @default(0)

  @@index([itemId])
}

// A room, measured wall by wall.
//
// `walls` is JSON — an ordered list of { lengthIn, turnDeg, label } — because a
// room outline is a document, not a set of rows anybody will ever query. The
// corners are derived from it (see @/lib/floorplan), so the drawing can never
// disagree with the measurements somebody typed off a tape.
model FloorPlan {
  id        String   @id @default(cuid())
  name      String
  // Grid the booths snap to, in inches. 3 is a comfortable default; 0 is free.
  gridIn    Int      @default(3)
  notes     String   @default("")
  sortOrder Int      @default(0)
  walls     Json     @default("[]")
  spaces    FloorSpace[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// One booth or display on a plan.
//
// Positions and sizes are INCHES, always — see the note at the top of
// @/lib/floorplan. A plan stored in pixels stops being a measurement the first
// time somebody opens it on a different screen.
model FloorSpace {
  id          String    @id @default(cuid())
  planId      String
  plan        FloorPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  // BOOTH | SHELF | TABLE | DESK | FIXTURE | WALKWAY. One shape with a kind rather than
  // a table per thing: a register desk and a 5x5 booth are both a rectangle
  // that must sit somewhere exact and not overlap anything, so they share all
  // the placement code and differ only in what they are called and whether a
  // vendor can be put in one.
  kind        String    @default("BOOTH")
  label       String    @default("")
  xIn         Int       @default(0)
  yIn         Int       @default(0)
  widthIn     Int       @default(60)
  depthIn     Int       @default(60)
  // Any angle, 0-359, turned about the rectangle's own centre. Quarter turns
  // only was wrong twice over: turning a square booth did nothing visible, and
  // a booth against an angled wall could not be drawn at the wall's angle.
  rotationDeg Int       @default(0)
  // RECT | LCORNER. An L is the bounding box minus a notch, so widthIn and
  // depthIn stay the two ARM LENGTHS and legIn is the shelf's own depth. A
  // corner unit is then described the way it is measured and bought rather
  // than as two rectangles somebody has to keep pushed together.
  shape       String    @default("RECT")
  // Shelf depth in inches. Only meaningful when shape is LCORNER.
  legIn       Int       @default(0)
  // AVAILABLE | HELD | TAKEN
  status      String    @default("AVAILABLE")
  // Who is in it. Plain ids rather than relations: a vendor leaving should not
  // cascade-delete the space they were standing in.
  vendorId    String    @default("")
  contractId  String    @default("")
  notes       String    @default("")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([planId])
  @@index([vendorId])
}
